# Server-side Tinker credentials. Never commit your .env.
TINKER_API_KEY=
# Your account's saved sampler checkpoint, e.g. tinker://.../sampler_weights/...
TINKER_MODEL_PATH=

# Estimated token-spend cap for this installation; scheduling stops at 90%.
# This is a local guard, not your Tinker account's billing balance.
FLOOR_BUDGET_USD=5

# Set both before exposing a single-seller desk over HTTPS.
FLOOR_USERNAME=
FLOOR_PASSWORD=

# Optional overrides. Container defaults already use /data.
# FLOOR_STATE_DIR=/absolute/path/to/persistent/state
# FLOOR_DESK_DB=/absolute/path/to/floor.sqlite3
# PORT=8000
